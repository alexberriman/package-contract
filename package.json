{
  "name": "package-contract",
  "version": "1.0.0",
  "description": "Test the npm package your users actually install.",
  "keywords": [
    "npm",
    "package",
    "testing",
    "typescript",
    "esm",
    "exports",
    "ci"
  ],
  "homepage": "https://github.com/alexberriman/package-contract#readme",
  "bugs": {
    "url": "https://github.com/alexberriman/package-contract/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexberriman/package-contract.git"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/alexberriman"
  },
  "license": "MIT",
  "author": "Alex Berriman",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "docs",
    "CODE_OF_CONDUCT.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "README.md",
    "SECURITY.md",
    "SUPPORT.md"
  ],
  "bin": {
    "package-contract": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@12.0.1",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "audit:licenses": "node scripts/audit-licenses.mjs",
    "build": "node node_modules/typescript/bin/tsc -p tsconfig.build.json",
    "check": "npm run format:check && npm run typecheck && npm run deadcode && npm run test",
    "clean": "node --input-type=module -e \"import { rm } from 'node:fs/promises'; await Promise.all(['coverage', 'dist'].map(path => rm(path, { recursive: true, force: true })))\"",
    "deadcode": "knip --no-progress",
    "format": "biome check --write .",
    "format:check": "biome check .",
    "prepack": "npm run clean && npm run build",
    "prepublishOnly": "npm run release:check",
    "release:check": "npm run check && npm run test:coverage && npm run build && npm audit --omit=dev && npm run audit:licenses",
    "release:prepare": "node scripts/prepare-release.mjs",
    "release:publish": "node scripts/publish-release.mjs",
    "test": "vitest run",
    "test:corpus": "vitest run test/corpus.test.ts",
    "test:coverage": "vitest run --coverage && node scripts/check-coverage.mjs",
    "test:runtime-version": "vitest run test/runtime-version.test.ts",
    "test:unit": "vitest run --exclude test/corpus.test.ts",
    "typecheck": "node node_modules/typescript/bin/tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "typescript": ">=5.6 <7 || >=7.0.2 <7.1"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@biomejs/biome": "2.5.6",
    "@types/node": "26.1.2",
    "@vitest/coverage-v8": "4.1.10",
    "knip": "6.29.0",
    "typescript": "7.0.2",
    "typescript-5-6": "npm:typescript@5.6.3",
    "typescript-6": "npm:typescript@6.0.3",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "@arethetypeswrong/core": "0.18.5",
    "@publint/pack": "0.1.6",
    "publint": "0.3.22"
  }
}
