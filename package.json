{
  "name": "package-contract",
  "version": "0.0.0",
  "description": "Test the npm package your users actually install.",
  "keywords": [
    "npm",
    "package",
    "testing",
    "typescript",
    "esm",
    "exports",
    "ci"
  ],
  "homepage": "https://github.com/alexberriman/package-contract#readme",
  "bugs": {
    "url": "https://github.com/alexberriman/package-contract/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexberriman/package-contract.git"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/alexberriman"
  },
  "license": "MIT",
  "author": "Alex Berriman",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "docs/diagnostics",
    "LICENSE",
    "README.md",
    "SECURITY.md"
  ],
  "bin": {
    "package-contract": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@12.0.1",
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "npm run format:check && npm run typecheck && npm run test",
    "clean": "node --input-type=module -e \"import { rm } from 'node:fs/promises'; await Promise.all(['coverage', 'dist'].map(path => rm(path, { recursive: true, force: true })))\"",
    "format": "biome check --write .",
    "format:check": "biome check .",
    "prepack": "npm run clean && npm run build",
    "prepublishOnly": "npm run release:check",
    "release:check": "npm run check && npm run test:coverage && npm run build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "typescript": ">=5.6 <8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@types/node": "26.1.1",
    "@vitest/coverage-v8": "4.1.10",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "directories": {
    "test": "test"
  },
  "dependencies": {
    "assertion-error": "^2.0.1",
    "ast-v8-to-istanbul": "^1.0.5",
    "chai": "^6.2.2",
    "convert-source-map": "^2.0.0",
    "detect-libc": "^2.1.2",
    "es-module-lexer": "^2.3.1",
    "estree-walker": "^3.0.3",
    "expect-type": "^1.4.0",
    "fdir": "^6.5.0",
    "has-flag": "^4.0.0",
    "html-escaper": "^2.0.2",
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-lib-report": "^3.0.1",
    "istanbul-reports": "^3.2.0",
    "js-tokens": "^10.0.0",
    "lightningcss": "^1.33.0",
    "lightningcss-linux-arm64-gnu": "^1.33.0",
    "magic-string": "^0.30.21",
    "magicast": "^0.5.3",
    "make-dir": "^4.0.0",
    "nanoid": "^3.3.16",
    "obug": "^2.1.4",
    "pathe": "^2.0.3",
    "picocolors": "^1.1.1",
    "picomatch": "^4.0.5",
    "postcss": "^8.5.23",
    "rolldown": "^1.1.5",
    "semver": "^7.8.5",
    "siginfo": "^2.0.0",
    "source-map-js": "^1.2.1",
    "stackback": "^0.0.2",
    "std-env": "^4.2.0",
    "supports-color": "^7.2.0",
    "tinybench": "^2.9.0",
    "tinyexec": "^1.2.4",
    "tinyglobby": "^0.2.17",
    "tinyrainbow": "^3.1.0",
    "undici-types": "^8.3.0",
    "vite": "^8.1.5",
    "why-is-node-running": "^2.3.0"
  }
}
